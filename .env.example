# Server-only. Run neon deploy to populate .env.local; never use VITE_DATABASE_URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
# Optional local HTTP port (default 5174)
PORT=5174
APP_PROFILE=development
# Explicit opt-in for local single-operator demonstration snapshots only.
# Never enable for a production/multi-user app. Real workspace uses scoped APIs.
LOCAL_DEMO_ARCHIVE=0
# Verified region of this project's Neon database.
APP_DATA_REGION=aws-us-east-2
APP_ORIGIN=http://localhost:5174
# Populated by npm run backend:setup; server-only, never prefix with VITE_.
APP_DATABASE_URL=
AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=
# Provisioned server-side by backend:setup (32-byte hex); back up securely.
SOURCE_ENCRYPTION_KEY=
# Private Neon Object Storage credentials, pulled by neon deploy. Never VITE_*.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
