{
  "name": "financial-workspace-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "start": "node server/index.mjs",
    "db:migrate": "node server/migrate.mjs",
    "db:generate": "node database/generate.mjs",
    "db:catalog": "node database/inspect.mjs",
    "backend:setup": "npm run db:migrate && node server/provision-runtime.mjs",
    "backend:test:api": "node verification/backend-api.mjs",
    "backend:test:browser": "node verification/backend-browser.mjs",
    "backend:test:financial": "node verification/financial-api.mjs",
    "backend:test:bank": "node verification/bank-api.mjs",
    "backend:test:matches": "node verification/matches-api.mjs",
    "backend:readiness": "node verification/backend-readiness.mjs --release",
    "backend:test:manual": "node verification/manual-allocation-api.mjs",
    "backend:test:review": "node verification/review-membership-api.mjs",
    "backend:test:items": "node verification/reconciliation-items-api.mjs",
    "worker:scan": "node server/scan-worker.mjs",
    "backend:test:scan": "node verification/scan-jobs-api.mjs",
    "db:verify": "node verification/srs-database.mjs",
    "db:verify:production": "node verification/srs-database.mjs --production",
    "build": "npm --prefix ../front run build",
    "test": "npm run test:backend && npm --prefix ../front test",
    "test:backend": "vitest run",
    "backend:test:privacy": "node verification/data-lifecycle-api.mjs",
    "beta:preflight": "node verification/beta-preflight.mjs",
    "beta:smoke": "node verification/beta-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@aws-sdk/s3-presigned-post": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "better-auth": "1.7.15",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "files-sdk": "^3.1.2",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "saxes": "5.0.1",
    "zod": "^4.6.7",
    "vite": "^6.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "jszip": "3.10.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
