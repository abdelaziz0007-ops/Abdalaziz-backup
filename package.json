{
  "name": "financial-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "start": "node server/index.mjs",
    "db:migrate": "node server/migrate.mjs",
    "db:generate": "node database/generate.mjs",
    "db:catalog": "node database/inspect.mjs",
    "db:verify": "node verification/srs-database.mjs",
    "db:verify:production": "node verification/srs-database.mjs --production",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.12"
  }
}
