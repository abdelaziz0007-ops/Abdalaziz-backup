[Unit]
Description=Mizan isolated source scan worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mizan
Group=mizan
WorkingDirectory=/opt/mizan/backend
Environment=NODE_ENV=production
Environment=APP_PROFILE=production
EnvironmentFile=/etc/mizan/scanner.env
ExecStart=/usr/bin/node /opt/mizan/backend/server/scan-worker.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
